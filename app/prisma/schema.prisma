generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MECHANIC
  ATTENDANT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid()) @db.Uuid
  name              String    @db.VarChar(150)
  email             String    @unique @db.VarChar(150)
  cpf               String?   @unique @db.VarChar(11)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  role              UserRole?
  isActive          Boolean   @default(true) @map("is_active")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("users")
}

// ─── Outbox ───────────────────────────────────────────────────────────────────

model OutboxMessage {
  id           BigInt   @id @default(autoincrement())
  messageId    String   @unique @default(uuid()) @map("message_id") @db.Uuid
  type         String   @db.VarChar(64)
  workOrderId  String?  @map("work_order_id") @db.Uuid
  payload      Json
  traceContext Json     @default("{}") @map("trace_context")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("outbox")
}
